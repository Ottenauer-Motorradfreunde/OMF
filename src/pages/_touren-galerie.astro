---
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import PageHero from "../components/PageHero.astro";
import PlaceholderNotice from "../components/PlaceholderNotice.astro";
import { galleries } from "../data/galleries";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Touren & Galerie"
  description="Touren und Bildalben der Ottenauer Motorradfreunde."
  noIndex={true}
>
  <PageHero
    eyebrow="Touren & Galerie"
    title="Die schönsten Kilometer bleiben."
    intro="Alben statt Bilderflut: Touren, Wege und gemeinsame Momente bekommen hier ihren Platz."
    imageLabel="Touren"
    imageDescription="Tourenfoto der OMF folgt"
  />
  <section class="galleries section" aria-labelledby="gallery-title">
    <div class="container">
      <div class="galleries__intro">
        <p class="eyebrow">Alben</p>
        <h2 id="gallery-title">Unterwegs mit OMF</h2>
      </div>
      <PlaceholderNotice>
        Die Alben zeigen die spätere Struktur. Echte Tourdaten und Bilder werden
        erst nach Auswahl und Freigabe veröffentlicht.
      </PlaceholderNotice>
      <div class="galleries__grid">
        {galleries.map((gallery, index) => (
          <article>
            <MediaPlaceholder
              category="Beispielalbum"
              description={gallery.coverImage.alt}
              tone={index === 1 ? "dark" : "light"}
              aspect={index === 1 ? "portrait" : "landscape"}
            />
            <div>
              <span>
                {gallery.placeholder ? "Beispielinhalt" : gallery.date}
              </span>
              <h3>{gallery.title}</h3>
              <p>{gallery.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .galleries {
    background: var(--color-paper-bright);
  }
  .galleries__intro h2 {
    margin: var(--space-2) 0 var(--space-6);
    font-family: var(--font-display);
    font-size: var(--step-3);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .galleries__grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  article {
    display: grid;
    gap: var(--space-4);
  }
  article :global(.media-placeholder) {
    min-height: 18rem;
  }
  article > div {
    padding-top: var(--space-3);
    border-top: 0.0625rem solid var(--color-line);
  }
  span {
    color: var(--color-muted);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  h3 {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  p {
    margin: 0;
    color: var(--color-muted);
  }
  @media (min-width: 58rem) {
    .galleries__grid {
      grid-template-columns: 1.15fr 0.85fr 0.85fr;
      align-items: start;
    }
    article:nth-child(2) {
      margin-top: var(--space-7);
    }
    article:nth-child(3) {
      margin-top: var(--space-5);
    }
  }
</style>
