---
import V9Photo from "../components/V9Photo.astro";
import { siteConfig } from "../config/site";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const asset = (file: string) => `${basePath}v9/assets/${file}`;
const assetRevision = "20261003-1";
const instagramUrl = "https://www.instagram.com/omf19762026/";
const pageTitle = `${siteConfig.name} | Motorradverein in Gaggenau`;
const description =
  "Ottenauer Motorradfreunde e. V.: Motorradverein in Gaggenau-Ottenau seit 1976. Gemeinsame Touren, Stammtisch und Einblicke in unser Vereinsleben.";
const canonicalUrl = "https://www.ottenauer-motorradfreunde.de/";
const socialImage = new URL(asset("gemeinschaft-2016-1920.webp"), canonicalUrl)
  .href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${canonicalUrl}#organization`,
      name: siteConfig.name,
      alternateName: siteConfig.shortName,
      url: canonicalUrl,
      logo: new URL(asset("omf-logo-transparent-v2.png"), canonicalUrl).href,
      location: { "@type": "Place", name: siteConfig.location },
      sameAs: [instagramUrl],
    },
    {
      "@type": "WebSite",
      "@id": `${canonicalUrl}#website`,
      name: siteConfig.name,
      alternateName: siteConfig.shortName,
      url: canonicalUrl,
      inLanguage: "de-DE",
      publisher: { "@id": `${canonicalUrl}#organization` },
    },
  ],
};
const venueMapUrl =
  "https://www.openstreetmap.org/export/embed.html?bbox=8.3305%2C48.7868%2C8.3397%2C48.7905&layer=mapnik&marker=48.78862%2C8.33508";
const venueMapLink =
  "https://www.openstreetmap.org/?mlat=48.78862&mlon=8.33508#map=17/48.78862/8.33508";
const directionsUrl =
  "https://www.google.com/maps/dir/?api=1&destination=Merkurhalle%20Ottenau%2C%20Gaggenau";
const photoSources = (name: string) => {
  const maxWidth =
    name === "clubhaus" ? 1148 : name === "gemeinsame-touren" ? 1840 : 1920;
  const sizes = [640, 1280, 1920].filter(
    (width, index, widths) =>
      index === 0 ||
      Math.min(widths[index - 1], maxWidth) !== Math.min(width, maxWidth),
  );
  return sizes
    .map(
      (width) =>
        `${asset(`${name}-${width}.webp`)} ${Math.min(width, maxWidth)}w`,
    )
    .join(", ");
};

const navigation = [
  { href: "#jubilaeum", label: "Jubiläum" },
  { href: "#aktuell", label: "Vereinsleben" },
  { href: "#geschichte", label: "Verein" },
  { href: "#kontakt", label: "Kontakt" },
];

const clubStories = [
  {
    image: "gemeinschaft-2016",
    alt: "Mitglieder der Ottenauer Motorradfreunde beim 40-jährigen Jubiläum 2016 mit zwei klassischen Motorrädern",
    width: 1920,
    height: 863,
    category: "Gemeinschaft",
    detail: "Rückblick · 2016",
    title: "Mehr als Motorräder",
    caption:
      "Gemeinschaft beim 40-jährigen Jubiläum der Ottenauer Motorradfreunde im Jahr 2016.",
    text: "Unser gemeinsames Hobby verbindet Generationen. Seit 1976 gehören gemeinsame Erlebnisse und die Freude am Vereinsleben dazu – hier beim 40-jährigen Jubiläum 2016.",
  },
  {
    image: "gemeinsame-touren",
    alt: "Verschiedene Touren- und Sportmotorräder bei einer gemeinsamen Ausfahrt",
    width: 1840,
    height: 1035,
    category: "Unterwegs",
    detail: "Gemeinsame Ausfahrten",
    title: "Gemeinsame Touren",
    caption:
      "Gemeinsam unterwegs: eine Pause mit den Motorrädern auf einer unserer Ausfahrten.",
    text: "Ob durchs Murgtal oder weiter hinaus: Zusammen unterwegs zu sein und die nächste Pause miteinander zu genießen, macht unser Hobby besonders.",
  },
  {
    image: "clubhaus",
    alt: "Drei Motorradfreunde mit ihren Motorrädern vor dem OMF-Clubhaus direkt nach der Rückkehr von einer 3.100-Kilometer-Tour",
    width: 1148,
    height: 780,
    category: "Treffpunkt",
    detail: "Gaggenau-Ottenau",
    title: "Unser Clubhaus",
    caption:
      "Nach 3.100 Kilometern über Dresden durch Tschechien, Polen, die Slowakei, Ungarn und Österreich wieder am Clubhaus – festgehalten direkt nach der Rückkehr.",
    text: "Hier treffen wir uns zum Stammtisch, tauschen uns aus und lernen neue Motorradfreunde kennen. Wer Interesse hat, kann einfach vorbeischauen oder vorher Kontakt aufnehmen.",
  },
];

const history = [
  {
    year: 1976,
    title: "Gründung",
    text: "Die Ottenauer Motorradfreunde werden gegründet.",
  },
  {
    year: 2016,
    title: "40 Jahre OMF",
    text: "Zum 40-jährigen Bestehen wurden Jubiläumsfeier und Murgtalausfahrt angekündigt.",
  },
  {
    year: 2022,
    title: "3. Motorradausstellung",
    text: "Für Ende Oktober wurden rund 80 Zweiräder und Raritäten in der Merkurhalle angekündigt.",
  },
  {
    year: 2024,
    title: "Erste-Hilfe-Kurs",
    text: "Ein spezieller Kurs für Motorradunfälle wurde gemeinsam mit dem DRK-Ortsverein durchgeführt.",
  },
  {
    year: 2026,
    title: "50 Jahre OMF",
    text: "Das Jubiläum wird im Oktober in der Merkurhalle Ottenau gefeiert.",
  },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="theme-color" content="#0f1110" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="863" />
    <meta
      property="og:image:alt"
      content="Ottenauer Motorradfreunde beim 40-jährigen Jubiläum 2016"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="Ottenauer Motorradfreunde beim 40-jährigen Jubiläum 2016"
    />
    <link rel="canonical" href={canonicalUrl} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    ></script>
    <link rel="icon" href={asset("omf-logo.webp")} />
    <link
      rel="stylesheet"
      href={`${basePath}v9/styles/main.css?v=${assetRevision}`}
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script
      is:inline
      src={`${basePath}v9/scripts/main.js?v=${assetRevision}`}
      defer
    ></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Zum Inhalt springen
    </a>

    <header class="site-header" id="header">
      <div class="wrap nav">
        <a class="brand" href="#top" aria-label="Startseite OMF">
          <span class="brand-badge">
            <img
              src={asset("omf-logo-transparent-v2.png")}
              alt=""
              width="1000"
              height="630"
            />
          </span>
          <span class="brand-copy">
            <strong>Ottenauer Motorradfreunde</strong>
            <span>Gaggenau-Ottenau · seit 1976</span>
          </span>
        </a>
        <nav class="navlinks" aria-label="Hauptnavigation">
          {navigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <button
          class="menu-btn"
          id="menuBtn"
          type="button"
          aria-label="Menü öffnen"
          aria-expanded="false"
          aria-controls="drawer"
        >
          <span></span>
        </button>
      </div>
    </header>

    <div class="drawer" id="drawer" aria-hidden="true">
      <nav aria-label="Mobile Hauptnavigation">
        {navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
      <small>Ottenauer Motorradfreunde e. V.</small>
    </div>

    <main id="main-content">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-media" aria-hidden="true"></div>
        <div class="wrap hero-content">
          <div class="hero-accents">
            <a class="hero-meeting" href="#kontakt">
              <span class="hero-meeting__label">Nächster Treffpunkt</span>
              <strong>Stammtisch · jeden 2. Donnerstag</strong>
              <span>Ab ca. 19 Uhr im Clubhaus</span>
            </a>

            <div class="anniversary-seal" aria-hidden="true">
              <span class="anniversary-seal__branch anniversary-seal__branch--left"></span>
              <span class="anniversary-seal__branch anniversary-seal__branch--right"></span>
              <span class="anniversary-seal__content">
                <span class="anniversary-seal__logo-frame">
                  <img
                    class="anniversary-seal__logo"
                    src={asset("omf-logo-transparent-v2.png")}
                    alt=""
                    width="1000"
                    height="630"
                  />
                </span>
                <strong>50 Jahre</strong>
                <span>1976 — 2026</span>
              </span>
              <span class="anniversary-seal__glint"></span>
            </div>
          </div>

          <div class="hero-grid">
            <div>
              <div class="eyebrow">Ottenauer Motorradfreunde e. V.</div>
              <h1 class="display" id="hero-title">
                Gemeinsam
                <br />
                unterwegs.
              </h1>
              <p class="hero-copy">
                Motorräder, gemeinsame Touren, Veranstaltungen und ein
                Vereinsleben, das seit Jahrzehnten verbindet – zuhause in
                Ottenau, unterwegs im Murgtal und weit darüber hinaus.
              </p>
              <div class="btnrow hero-actions">
                <a class="btn primary" href="#jubilaeum">
                  50 Jahre OMF
                </a>
                <a class="btn ghost" href="#kontakt">
                  Mitfahren & Kontakt
                </a>
              </div>
            </div>
            <aside class="hero-panel">
              <div class="eyebrow">Jubiläumsjahr</div>
              <h2>1976 — 2026</h2>
              <p>
                2026 feiern die Ottenauer Motorradfreunde ihr 50-jähriges
                Bestehen.
              </p>
            </aside>
          </div>
        </div>
      </section>

      <section
        class="section dark"
        id="jubilaeum"
        aria-labelledby="event-title"
      >
        <div class="wrap">
          <div class="section-head reveal">
            <div>
              <div class="eyebrow">Nächster großer Termin</div>
              <h2 class="display" id="event-title">
                50 Jahre OMF
              </h2>
            </div>
          </div>
          <article class="card dark event-box reveal">
            <figure class="event-media">
              <V9Photo
                src={asset("gemeinschaft-2016-1280.webp")}
                srcset={photoSources("gemeinschaft-2016")}
                fullSrc={asset("gemeinschaft-2016-1920.webp")}
                caption="Rückblick: 40 Jahre OMF · 2016"
                sizes="(max-width: 1020px) 92vw, 560px"
                alt="Gemeinsames Gruppenfoto zum 40-jährigen Vereinsjubiläum 2016"
                width={1920}
                height={863}
              />
              <figcaption>Rückblick: 40 Jahre OMF · 2016</figcaption>
            </figure>
            <div class="event-main">
              <div class="pill">
                <span class="dot"></span> Jubiläumsfest
              </div>
              <h3>
                <time datetime="2026-10-17">17.–18. Oktober 2026</time>
                <br />
                Merkurhalle Ottenau
              </h3>
              <div class="event-meta">
                <span>🕥 im Kalender ab 10:30 Uhr</span>
                <span>📍 Merkurhalle Ottenau</span>
              </div>
              <div
                class="countdown"
                id="countdown"
                data-target="2026-10-17T10:30:00+02:00"
                aria-label="Zeit bis zum Jubiläumsfest"
                aria-live="off"
              >
                {[
                  ["days", "Tage"],
                  ["hours", "Stunden"],
                  ["minutes", "Minuten"],
                  ["seconds", "Sekunden"],
                ].map(([unit, label]) => (
                  <div class="count">
                    <b data-count={unit}>–</b>
                    <small>{label}</small>
                  </div>
                ))}
              </div>
              <p id="countdown-status" hidden>
                Jubiläum läuft / Termin erreicht
              </p>
            </div>
          </article>
          <section
            class="card dark venue-map reveal"
            aria-labelledby="venue-map-title"
          >
            <div class="venue-map__details">
              <div class="venue-map__address">
                <div class="eyebrow">Anfahrt</div>
                <h3 class="display" id="venue-map-title">
                  Merkurhalle Ottenau
                </h3>
                <p>
                  Furtwänglerstraße 15
                  <br />
                  76571 Gaggenau-Ottenau
                </p>
              </div>
              <div class="venue-map__actions">
                <a
                  class="event-directions"
                  href={directionsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Anfahrt zur Merkurhalle
                  <small>Route in Google Maps öffnen</small>
                </a>
                <a
                  class="venue-map__link"
                  href={venueMapLink}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Standort in OpenStreetMap öffnen
                </a>
                <button
                  type="button"
                  class="venue-map__unload"
                  data-map-unload
                  hidden
                >
                  Karte ausblenden
                </button>
                <p class="venue-map__status" role="status" data-map-status></p>
              </div>
            </div>
            <div class="venue-map__viewer">
              <div class="venue-map__preview" data-map-preview>
                <img
                  src={asset("merkurhalle-map-preview.png")}
                  width="706"
                  height="355"
                  loading="lazy"
                  alt="Kartenansicht von Ottenau mit der Merkurhalle an der Furtwänglerstraße markiert"
                />
                <button
                  class="btn primary"
                  type="button"
                  data-map-open
                  aria-controls="venue-map-consent"
                  aria-expanded="false"
                  hidden
                >
                  Interaktive Karte öffnen
                </button>
                <a
                  class="venue-map__attribution"
                  href="https://www.openstreetmap.org/copyright"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  © OpenStreetMap-Mitwirkende
                </a>
              </div>
              <div
                id="venue-map-consent"
                class="venue-map__placeholder"
                data-map-placeholder
                hidden
              >
                <strong>Interaktive Karte</strong>
                <p id="venue-map-notice">
                  Mit „Karte laden“ erlaubst du die Verbindung zu OpenStreetMap.
                  Dabei werden deine IP-Adresse und technische Verbindungsdaten
                  übermittelt.
                </p>
                <button
                  class="btn primary"
                  type="button"
                  data-map-load
                  aria-controls="venue-map-frame"
                  aria-describedby="venue-map-notice"
                >
                  Karte laden
                </button>
                <button class="venue-map__cancel" type="button" data-map-cancel>
                  Zurück zur Vorschau
                </button>
                <a href={`${basePath}datenschutz/#map-title`}>
                  Datenschutzhinweise zur Karte
                </a>
              </div>
              <div
                id="venue-map-frame"
                class="venue-map__frame"
                data-map-url={venueMapUrl}
                hidden
              ></div>
            </div>
          </section>
        </div>
      </section>

      <section class="section" id="aktuell" aria-labelledby="news-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div>
              <div class="eyebrow">Einblicke</div>
              <h2 class="display" id="news-title">
                Das ist unser Verein
              </h2>
            </div>
          </div>
          <div class="news-grid">
            {clubStories.map((item) => (
              <article class="story reveal">
                <figure class="story-photo">
                  <V9Photo
                    class="thumb"
                    src={asset(`${item.image}-1280.webp`)}
                    srcset={photoSources(item.image)}
                    fullSrc={asset(`${item.image}-1920.webp`)}
                    caption={item.caption}
                    sizes="(max-width: 720px) 92vw, (max-width: 1020px) 45vw, 380px"
                    alt={item.alt}
                    width={item.width}
                    height={item.height}
                  />
                  <figcaption>{item.caption}</figcaption>
                </figure>
                <div class="story-meta">
                  <span>{item.category}</span>
                  <span>{item.detail}</span>
                </div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section
        class="section dark"
        id="geschichte"
        aria-labelledby="history-title"
      >
        <div class="wrap">
          <div class="timeline reveal">
            <div class="intro-col">
              <div class="eyebrow">Verein & Geschichte</div>
              <h2 class="display" id="history-title">
                Seit
                <br />
                1976.
              </h2>
            </div>
            <div class="timeline-list">
              {history.map((item) => (
                <div class="time-row">
                  <div class="year">{item.year}</div>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <figure class="history-photo reveal">
            <V9Photo
              src={asset("vereinsgeschichte-1280.webp")}
              srcset={photoSources("vereinsgeschichte")}
              fullSrc={asset("vereinsgeschichte-1920.webp")}
              caption="Gemeinsam unterwegs – ein Blick in unser Vereinsarchiv"
              sizes="(max-width: 1280px) 92vw, 1180px"
              alt="Historisches Gruppenfoto der Ottenauer Motorradfreunde mit ihren Motorrädern im Freien"
              width={1920}
              height={807}
            />
            <figcaption>
              Gemeinsam unterwegs – ein Blick in unser Vereinsarchiv.
            </figcaption>
          </figure>
        </div>
      </section>

      <section
        class="section dark"
        id="kontakt"
        aria-labelledby="contact-title"
      >
        <div class="wrap contact-grid reveal">
          <div class="card dark join-box">
            <div class="eyebrow">Mitfahren & kennenlernen</div>
            <h2 class="display" id="contact-title">
              Du fährst
              <br />
              Motorrad?
            </h2>
            <p>
              Wer Interesse hat, schaut einfach beim Stammtisch im Clubhaus
              vorbei. Vorab kannst du auch telefonisch oder per WhatsApp Kontakt
              aufnehmen.
            </p>
            <div class="meeting">
              <div class="item">
                <b>Stammtisch</b>
                <span>Jeden 2. Donnerstag</span>
              </div>
              <div class="item">
                <b>Beginn</b>
                <span>Ab ca. 19 Uhr</span>
              </div>
            </div>
          </div>
          <div class="card dark join-box">
            <div class="eyebrow">Kontakt</div>
            <div class="contact-list">
              <div class="contact">
                <div>
                  <strong>1. Vorstand</strong>
                  <span>Paul Riedinger</span>
                </div>
                <div>
                  <a href="tel:+491727356667">0172 7356667</a>
                  <a href="mailto:paul.riedinger@matsches.com">
                    paul.riedinger@matsches.com
                  </a>
                </div>
              </div>
              <div class="contact">
                <div>
                  <strong>Kassierer</strong>
                  <span>Matthias Lang</span>
                </div>
                <div>
                  <a href="tel:+4915731584556">0157 31584556</a>
                  <a href="mailto:1204matsches@web.de">1204matsches@web.de</a>
                </div>
              </div>
              <div class="contact">
                <div>
                  <strong>Vereinsgelände</strong>
                </div>
                <div>
                  <span>Berliner Straße 4 / Berliner Brücke</span>
                  <span>76571 Gaggenau-Ottenau</span>
                </div>
              </div>
            </div>
            <div class="contact-social">
              <p>Auch auf Instagram findest du uns:</p>
              <a
                class="btn ghost social-profile"
                href={instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="OMF auf Instagram: @omf19762026 (öffnet in neuem Tab)"
              >
                <img
                  class="instagram-glyph"
                  src={asset("instagram-glyph-white.svg")}
                  alt=""
                  width="30"
                  height="30"
                  loading="lazy"
                  decoding="async"
                />
                <span>
                  <strong>OMF auf Instagram</strong>
                  <small>@omf19762026</small>
                </span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <dialog
      class="photo-viewer"
      id="photo-viewer"
      aria-labelledby="photo-viewer-caption"
    >
      <button
        type="button"
        class="photo-viewer__close"
        aria-label="Großansicht schließen"
      >
        ×
      </button>
      <figure class="photo-viewer__figure">
        <img id="photo-viewer-image" alt="" />
        <figcaption id="photo-viewer-caption"></figcaption>
      </figure>
      <div class="photo-viewer__controls">
        <button type="button" data-photo-prev aria-label="Vorheriges Foto">
          ←
        </button>
        <span id="photo-viewer-counter" aria-live="polite"></span>
        <button type="button" data-photo-next aria-label="Nächstes Foto">
          →
        </button>
      </div>
    </dialog>

    <footer>
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <div class="footer-mark">
              <span class="footer-badge">
                <img
                  src={asset("omf-logo-transparent-v2.png")}
                  alt=""
                  width="1000"
                  height="630"
                  loading="lazy"
                />
              </span>
              <div>
                <div class="footer-title">OMF</div>
                <p>Ottenauer Motorradfreunde e. V.</p>
              </div>
            </div>
          </div>
          <nav aria-label="Navigation im Fußbereich">
            <h2>Navigation</h2>
            {navigation.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>
          <nav aria-label="Rechtliche Informationen">
            <h2>Informationen</h2>
            <a href={`${basePath}impressum/`}>Impressum</a>
            <a href={`${basePath}datenschutz/`}>Datenschutz</a>
          </nav>
        </div>
        <div class="footer-bottom">
          Ottenauer Motorradfreunde e. V. · Gaggenau-Ottenau
        </div>
      </div>
    </footer>
  </body>
</html>
